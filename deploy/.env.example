# Copy to deploy/.env (never commit it).
PUBLIC_IP=203.0.113.10
# librctl keygen -out relay.key -libp2p   -> third field
RELAY_PRIV_KEY=
# Other DB nodes to join through (/ip4/.../tcp/4002/p2p/<id>), comma-separated; empty on the first host.
LIBR_BOOTSTRAP=
# Seed servers to register with, e.g. https://seed.libr.example
LIBR_SEED_URLS=
# Communities this DB node refuses to store, comma-separated.
LIBR_OPTOUT=
